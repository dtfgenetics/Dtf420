    "prebuild:static-overlay": "npm run prepare:atlas-runtime",
    "build": "next build",
    "build:static-overlay": "DTF_STATIC_EXPORT=1 next build",
    "verify:static-overlay": "node scripts/verify-static-overlay.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:thc:import": "node scripts/import-thc-project-images.mjs",
    "assets:thc:verify": "node scripts/import-thc-project-images.mjs --verify-only",
    "verify:bud-or-bluff": "node scripts/verify-bud-or-bluff.mjs",
    "verify:burn-buds": "node scripts/verify-burn-buds.mjs",
    "verify:high-iq": "node scripts/verify-high-iq.mjs",
    "verify:grower-conversations": "node scripts/verify-grower-conversations.mjs",
    "verify:seed-ascent": "node scripts/verify-seed-ascent.mjs",
    "verify:strain-showdown": "node scripts/verify-strain-showdown.mjs",
    "verify:thc-rpg": "node scripts/sync-thc-rpg.mjs",
    "verify:atlas-interactive": "node scripts/verify-atlas-interactive.mjs",
    "verify:atlas-completion": "node scripts/verify-atlas-completion.mjs",
    "verify:atlas-assets": "node scripts/verify-atlas-assets.mjs",
    "verify:atlas-paths": "node scripts/verify-atlas-guided-paths.mjs",
    "verify:atlas-checks": "node scripts/verify-atlas-knowledge-checks.mjs",
    "verify:atlas-badges": "node scripts/verify-atlas-mastery-badges.mjs",
    "verify:atlas-cases": "node scripts/verify-atlas-diagnostic-cases.mjs",
    "verify:atlas-connections": "node scripts/verify-atlas-system-connections.mjs",
    "verify:atlas-visual-practice": "node scripts/verify-atlas-visual-identification.mjs",
    "verify:education-content": "node scripts/verify-education-content.mjs",
    "verify:education-links": "node scripts/verify-education-related-links.mjs",
    "verify:education-sources": "node scripts/verify-education-sources.mjs",
    "verify:education-glossary": "node scripts/verify-education-glossary.mjs",
    "verify:education-sops": "node scripts/verify-education-sops.mjs",
    "verify:academy": "node scripts/verify-academy.mjs",
    "verify:routes": "node scripts/verify-internal-routes.mjs",
    "verify": "npm run verify:bud-or-bluff && npm run verify:burn-buds && npm run verify:high-iq && npm run verify:grower-conversations && npm run verify:seed-ascent && npm run verify:strain-showdown && npm run verify:thc-rpg && npm run verify:atlas-interactive && npm run verify:atlas-completion && npm run verify:atlas-assets && npm run verify:atlas-paths && npm run verify:atlas-checks && npm run verify:atlas-badges && npm run verify:atlas-cases && npm run verify:atlas-connections && npm run verify:atlas-visual-practice && npm run verify:education-content && npm run verify:education-links && npm run verify:education-sources && npm run verify:education-glossary && npm run verify:education-sops && npm run verify:academy && npm run verify:routes && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.3",
    "phaser": "4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.0"
