{
  "name": "dtf420",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "predev": "npm run sync:thc-rpg && npm run prepare:atlas-runtime",
