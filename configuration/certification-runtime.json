{
  "schemaVersion": 1,
  "runtime": "next-node-api-subdomain",
  "database": {
    "engine": "mysql",
    "driver": "mysql2",
    "orm": "drizzle",
    "authoritative": true
  },
  "auth": {
    "provider": "better-auth",
    "userReferenceField": "auth_user_id",
    "runtimeOrigin": "https://learn-api.dtfseeds.com",
    "publicSiteOrigin": "https://dtfseeds.com"
  },
  "environment": {
    "requiredForProtectedRuntime": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "CERTIFICATE_VERIFY_ORIGIN"
    ],
    "canonicalValues": {
      "BETTER_AUTH_URL": "https://learn-api.dtfseeds.com",
      "CERTIFICATE_VERIFY_ORIGIN": "https://dtfseeds.com"
    }
  },
  "domainTables": [
    "learner_profiles",
    "course_progress",
    "assessment_versions",
    "assessment_attempts",
    "assessment_answers",
    "assessment_results",
    "credentials",
    "credential_verification_events"
  ],
  "assessmentStates": [
    "created",
    "active",
    "submitted",
    "graded",
    "expired",
    "abandoned",
    "invalidated"
  ],
  "credentialStates": [
    "valid",
    "revoked",
    "expired"
  ],
  "publicVerificationPath": "/verify/:publicCredentialId"
}
